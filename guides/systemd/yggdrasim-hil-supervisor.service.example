# Copy this file to:
#   ~/.config/systemd/user/yggdrasim-hil-supervisor.service
#
# Then adjust:
# - WorkingDirectory
# - ExecStart
# - --reader-index / --reader-name
# - --usb-vidpid
# - optional --remsim-arg selectors if osmo-remsim-client-st2 needs explicit SIMtrace2 selection
#
# This example assumes:
# - repository checkout at ~/Documents/Tools/YggdraSIM
# - Python venv at ~/Documents/pyscard
# - SIMtrace2 USB ID 1d50:60e3

[Unit]
Description=YggdraSIM HIL bridge supervisor
Documentation=file:%h/Documents/Tools/YggdraSIM/guides/HIL_BRIDGE_GUIDE.md
# Do not add ``After=default.target`` here. This unit is already pulled in
# by ``WantedBy=default.target``, so naming that target as a predecessor
# closes an ordering cycle. systemd resolves a cycle by deleting one of the
# start jobs, which means a unit silently never starts at boot -- and
# ``systemctl --user enable --now`` does not reproduce it, because starting
# a unit by hand never runs the boot transaction. Order against a concrete
# unit instead, the way the Remote Lab agent example orders itself after
# the Card Bridge.

[Service]
Type=simple
WorkingDirectory=%h/Documents/Tools/YggdraSIM
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Documents/pyscard/bin/python3 -m Tools.HilBridge.supervisor --reader-index 0 --host 127.0.0.1 --port 9997 --advertise-host 127.0.0.1 --usb-vidpid 1d50:60e3
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=default.target
