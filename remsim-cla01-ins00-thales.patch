 #include <libusb.h>
 
@@ -84,6 +85,43 @@ __attribute__((unused)) static int process_do_error(struct osmo_st2_cardem_inst
 
 static struct osmo_apdu_context ac; // this will hold the complete APDU (across calls)
 
+static int classify_local_proprietary_apdu(struct osmo_apdu_context *ac,
+					   const struct cardemu_usb_msg_rx_data *data)
+{
+	const uint8_t *hdr = data->data;
+
+	if (!(data->flags & CEMU_DATA_F_TPDU_HDR))
+		return 0;
+	if (data->data_len < sizeof(ac->hdr))
+		return 0;
+
+	/* Thales eSIM applet command seen on logical channel 1.
+	 * libosmocore's generic UICC table does not know INS=00, so the
+	 * regular APDU segmenter returns -1.  For this command P3 is Lc.
+	 */
+	if (hdr[0] == 0x01 && hdr[1] == 0x00) {
+		unsigned int body_len = data->data_len - sizeof(ac->hdr);
+
+		memset(ac, 0, sizeof(*ac));
+		memcpy(&ac->hdr, hdr, sizeof(ac->hdr));
+		ac->apdu_case = 3;
+		ac->lc.tot = ac->hdr.p3;
+
+		if (body_len > ac->lc.tot)
+			body_len = ac->lc.tot;
+		if (body_len) {
+			memcpy(ac->dc, hdr + sizeof(ac->hdr), body_len);
+			ac->lc.cur = body_len;
+		}
+
+		if (ac->lc.cur < ac->lc.tot)
+			return APDU_ACT_RX_MORE_CAPDU_FROM_READER;
+		return APDU_ACT_TX_CAPDU_TO_CARD;
+	}
+
+	return 0;
+}
